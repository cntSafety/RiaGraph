-DATASET CSV empty

--

# Intersect (the worst-case optimal join) over a multigraph: a list holds one entry per
# relationship, so a neighbour reached over parallel edges appears in it several times and every
# combination of those relationships is a match. Expected values are brute-force counts over each
# case's edge list (w numbers the edges from 1); the hash-join plan of the same pattern is run
# alongside and must agree.

-CASE IntersectParallelClosingEdge
# Two middle nodes reach c, and a reaches c over two parallel edges (#173).
-STATEMENT CREATE NODE TABLE P(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE REL TABLE K(FROM P TO P, w INT64);
---- ok
-STATEMENT UNWIND range(0, 3) AS i CREATE (:P {id: i});
---- ok
-STATEMENT UNWIND [[0, 1, 1], [0, 3, 2], [1, 2, 3], [3, 2, 4], [0, 2, 5], [0, 2, 6]] AS e
           MATCH (x:P {id: e[1]}), (y:P {id: e[2]}) CREATE (x)-[:K {w: e[3]}]->(y);
---- ok
-LOG Triangle, planner's choice
-STATEMENT MATCH (a:P)-[e1:K]->(b:P)-[e2:K]->(c:P), (a)-[e3:K]->(c)
           RETURN COUNT(*), SUM(e1.w + 2 * e2.w + 3 * e3.w);
---- 1
4|100
-LOG Triangle, forced Intersect
-STATEMENT MATCH (a:P)-[e1:K]->(b:P)-[e2:K]->(c:P), (a)-[e3:K]->(c)
           HINT (((a JOIN e1) JOIN b) MULTI_JOIN e2 MULTI_JOIN e3) JOIN c
           RETURN COUNT(*), SUM(e1.w + 2 * e2.w + 3 * e3.w);
---- 1
4|100
-LOG Triangle, hash join
-STATEMENT MATCH (a:P)-[e1:K]->(b:P)-[e2:K]->(c:P), (a)-[e3:K]->(c)
           HINT ((((a JOIN e1) JOIN b) JOIN e2) JOIN c) JOIN e3
           RETURN COUNT(*), SUM(e1.w + 2 * e2.w + 3 * e3.w);
---- 1
4|100
-LOG Triangle with an undirected closing edge, forced Intersect
-STATEMENT MATCH (a:P)-[e1:K]->(b:P)-[e2:K]->(c:P), (a)-[e3:K]-(c)
           HINT (((a JOIN e1) JOIN b) MULTI_JOIN e2 MULTI_JOIN e3) JOIN c
           RETURN COUNT(*), SUM(e1.w + 2 * e2.w + 3 * e3.w);
---- 1
4|100
-LOG Every closing relationship is produced for every middle node
-STATEMENT MATCH (a:P)-[e1:K]->(b:P)-[e2:K]->(c:P), (a)-[e3:K]->(c)
           HINT (((a JOIN e1) JOIN b) MULTI_JOIN e2 MULTI_JOIN e3) JOIN c
           RETURN b.id, e1.w, e2.w, e3.w ORDER BY b.id, e3.w;
---- 4
1|1|3|5
1|1|3|6
3|2|4|5
3|2|4|6

