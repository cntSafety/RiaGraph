-CASE IntersectParallelEdgesLargeLists
# 0->2 3000 times and 2->4 2500 times: both lists span two 2048-entry build tuples, and one probe
# (a=0, b=2, key c=4) yields 3000 x 2500 x 2 rows, far more than one output vector holds.
-STATEMENT CREATE NODE TABLE P(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE REL TABLE K(FROM P TO P, w INT64);
---- ok
-STATEMENT UNWIND range(0, 4) AS i CREATE (:P {id: i});
---- ok
-STATEMENT UNWIND range(1, 3000) AS i MATCH (x:P {id: 0}), (y:P {id: 2}) CREATE (x)-[:K {w: i}]->(y);
---- ok
-STATEMENT UNWIND [[0, 1, 0], [0, 3, 0], [1, 2, 1], [1, 2, 2], [1, 2, 3], [3, 2, 4], [3, 2, 5], [0, 4, 6], [0, 4, 7]] AS e
           MATCH (x:P {id: e[1]}), (y:P {id: e[2]}) CREATE (x)-[:K {w: e[3]}]->(y);
---- ok
-STATEMENT UNWIND range(1, 2500) AS i MATCH (x:P {id: 2}), (y:P {id: 4}) CREATE (x)-[:K {w: i}]->(y);
---- ok
-LOG Forced Intersect
-STATEMENT MATCH (a:P)-[e1:K]->(b:P)-[e2:K]->(c:P), (a)-[e3:K]->(c)
           HINT (((a JOIN e1) JOIN b) MULTI_JOIN e2 MULTI_JOIN e3) JOIN c
           RETURN b.id, c.id, COUNT(*), SUM(e2.w), SUM(e3.w) ORDER BY b.id, c.id;
