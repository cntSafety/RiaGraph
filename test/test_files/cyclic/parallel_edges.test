-LOG Hash join
-STATEMENT MATCH (a:P)-[e1:K]->(b:P)-[e2:K]->(c:P), (a)-[e3:K]->(c)
           HINT ((((a JOIN e1) JOIN b) JOIN e2) JOIN c) JOIN e3
           RETURN b.id, c.id, COUNT(*), SUM(e2.w), SUM(e3.w) ORDER BY b.id, c.id;
---- 3
