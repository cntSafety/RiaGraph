-DATASET CSV empty
--

# Regression test for LadybugDB/ladybug#1109.  # riag-rename:skip upstream provenance
# A second OPTIONAL MATCH correlated on a node the first one left NULL is planned as a
# correlated leg: distinct outer node IDs, then an extend from them. The NULL ID reached the
# extend, which read the slot as a node ID and returned the rels of the node it named, so some
# rows were duplicated and others lost their match. Person 32 has no comments; with this layout
# the wrong count (32007) was deterministic at one thread and varied at two and three.

-CASE ChainedOptionalMatchOverNullNode
-STATEMENT CALL threads=1
---- ok
-STATEMENT CREATE NODE TABLE Person(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE NODE TABLE Comment(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE NODE TABLE Post(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE hasCreator(FROM Comment TO Person);
---- ok
-STATEMENT CREATE REL TABLE replyOf(FROM Comment TO Post);
---- ok
-STATEMENT UNWIND range(0, 64) AS i CREATE (:Person {id: i});
---- ok
-STATEMENT CREATE (:Post {id: 0});
---- ok
-STATEMENT UNWIND range(0, 64) AS p WITH p WHERE p <> 32 UNWIND range(1, 500) AS k CREATE (:Comment {id: p * 100000 + k});
---- ok
-STATEMENT MATCH (c:Comment), (p:Person {id: c.id / 100000}) CREATE (c)-[:hasCreator]->(p);
---- ok
-STATEMENT MATCH (c:Comment), (m:Post {id: 0}) CREATE (c)-[:replyOf]->(m);
---- ok
-LOG OneThread
-STATEMENT UNWIND range(0, 64) AS i MATCH (a:Person {id: i})
           OPTIONAL MATCH (a)<-[:hasCreator]-(c:Comment)
           OPTIONAL MATCH (c)-[:replyOf]->(m:Post)
           RETURN count(*), count(c), count(m), count(DISTINCT c);
---- 1
32001|32000|32000|32000
-LOG OneThreadNullRowKept
-STATEMENT UNWIND range(0, 64) AS i MATCH (a:Person {id: i})
           OPTIONAL MATCH (a)<-[:hasCreator]-(c:Comment)
           OPTIONAL MATCH (c)-[:replyOf]->(m:Post)
           WITH a, c, m WHERE c IS NULL OR m IS NULL
           RETURN a.id, c.id, m.id;
---- 1
32||
-LOG EveryCommentMatchedOnce
-STATEMENT UNWIND range(0, 64) AS i MATCH (a:Person {id: i})
           OPTIONAL MATCH (a)<-[:hasCreator]-(c:Comment)
           OPTIONAL MATCH (c)-[:replyOf]->(m:Post)
           WITH c, count(*) AS numRows, count(m) AS n WHERE c IS NOT NULL AND (numRows <> 1 OR n <> 1)
           RETURN count(*);
---- 1
0
-STATEMENT CALL threads=2
---- ok
-LOG TwoThreads
-STATEMENT UNWIND range(0, 64) AS i MATCH (a:Person {id: i})
           OPTIONAL MATCH (a)<-[:hasCreator]-(c:Comment)
           OPTIONAL MATCH (c)-[:replyOf]->(m:Post)
           RETURN count(*), count(m);
---- 1
32001|32000
-STATEMENT CALL threads=3
---- ok
-LOG ThreeThreads
-STATEMENT UNWIND range(0, 64) AS i MATCH (a:Person {id: i})
           OPTIONAL MATCH (a)<-[:hasCreator]-(c:Comment)
           OPTIONAL MATCH (c)-[:replyOf]->(m:Post)
           RETURN count(*), count(m);
---- 1
32001|32000
-LOG ExistsOverNullNode
-STATEMENT UNWIND range(0, 64) AS i MATCH (a:Person {id: i})
           OPTIONAL MATCH (a)<-[:hasCreator]-(c:Comment)
           WITH a, c WHERE NOT EXISTS { MATCH (c)-[:replyOf]->(:Post) }
           RETURN a.id, c.id;
---- 1
32|
