-DATASET CSV empty

--

# INT128_MIN (-2^127) is a valid INT128 value. An operation has to succeed whenever its exact
# result fits in an INT128, even though the intermediate steps of the implementation work on the
# absolute value, which does not fit for INT128_MIN. The UNWIND keeps the planner from folding the
# operands into constants.
# m = INT128_MIN, one = 1, zero = 0, n = -1, two = 2.

-CASE Int128MinAddSubtract
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN m + zero;
---- 1
-170141183460469231731687303715884105728
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN m - zero;
---- 1
-170141183460469231731687303715884105728
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN (m + one) - one;
---- 1
-170141183460469231731687303715884105728
-STATEMENT UNWIND [1] AS i WITH CAST('170141183460469231731687303715884105727' AS INT128) AS mx, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN zero - one - mx;
---- 1
-170141183460469231731687303715884105728
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN m - one;
---- error
Overflow exception: INT128 is out of range: cannot subtract.
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN zero - m;
---- error
Overflow exception: INT128 is out of range: cannot subtract.
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN m + (zero - one);
---- error
Overflow exception: INT128 is out of range: cannot add.

-CASE Int128MinMultiply
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN m * one;
---- 1
-170141183460469231731687303715884105728
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN one * m;
---- 1
-170141183460469231731687303715884105728
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN m * zero;
---- 1
0
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN zero * m;
---- 1
0
# -2^64 * 2^63 = -2^127
-STATEMENT UNWIND [1] AS i WITH CAST('-18446744073709551616' AS INT128) AS a, CAST('9223372036854775808' AS INT128) AS b RETURN a * b;
---- 1
-170141183460469231731687303715884105728
-STATEMENT UNWIND [1] AS i WITH CAST('-18446744073709551616' AS INT128) AS a, CAST('9223372036854775808' AS INT128) AS b RETURN b * a;
---- 1
-170141183460469231731687303715884105728
# 2^127 - 1 times -1
-STATEMENT UNWIND [1] AS i WITH CAST('170141183460469231731687303715884105727' AS INT128) AS mx, CAST(i - 2 AS INT128) AS n RETURN mx * n;
---- 1
-170141183460469231731687303715884105727
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i AS INT128) AS one, CAST(i - 1 AS INT128) AS zero RETURN m * (one + one);
---- error
Overflow exception: INT128 is out of range: cannot multiply.
-STATEMENT UNWIND [1] AS i WITH CAST('-170141183460469231731687303715884105728' AS INT128) AS m, CAST(i - 2 AS INT128) AS n RETURN m * n;
---- error
Overflow exception: INT128 is out of range: cannot multiply.
-STATEMENT UNWIND [1] AS i WITH CAST('-18446744073709551616' AS INT128) AS a, CAST('9223372036854775809' AS INT128) AS b RETURN a * b;
---- error
