-DATASET CSV tinysnb

--

-CASE Random
-STATEMENT RETURN RANDOM()
---- ok
-STATEMENT RETURN setseed(0.2)
---- ok
-STATEMENT RETURN RANDOM()
---- 1
0.910543
-STATEMENT RETURN RANDOM()
---- 1
0.650728
-STATEMENT RETURN RANDOM()
---- 1
0.111587
-STATEMENT RETURN setseed(0.7)
---- ok
-STATEMENT RETURN RANDOM()
---- 1
0.545887
-STATEMENT RETURN setseed(0.2)
---- ok
-STATEMENT RETURN RANDOM()
---- 1
0.910543
-STATEMENT RETURN RANDOM()
---- 1
0.650728
-STATEMENT RETURN RANDOM()
---- 1
0.111587
-STATEMENT MATCH (p:person) RETURN p.id, random() limit 2
---- 2
0|0.528393
2|0.708328
-STATEMENT MATCH (p:person)-[:knows]->(p1:person) RETURN p.id, p1.id, random() as r ORDER BY r LIMIT 3
---- ok

-CASE RandomCallsAreIndependent
-STATEMENT RETURN setseed(0.2)
---- ok
-STATEMENT RETURN random() AS a, random() AS b
---- 1
0.910543|0.650728
-STATEMENT WITH random() AS a, random() AS b RETURN a <> b
---- 1
True
-STATEMENT WITH gen_random_uuid() AS u1, gen_random_uuid() AS u2 RETURN u1 <> u2
---- 1
True
-STATEMENT WITH gen_random_uuid() AS u RETURN u = u
---- 1
True

-CASE SetSeedRange
-STATEMENT RETURN setseed(0)
---- ok
-STATEMENT RETURN setseed(0.5)
---- ok
-STATEMENT RETURN setseed(0.9999999999999999)
---- ok
-STATEMENT RETURN setseed(1)
---- error
Runtime exception: Invalid seed 1: setseed expects a value in the range [0, 1).
-STATEMENT RETURN setseed(2.2)
---- error
Runtime exception: Invalid seed 2.2: setseed expects a value in the range [0, 1).
-STATEMENT RETURN setseed(-1)
---- error
Runtime exception: Invalid seed -1: setseed expects a value in the range [0, 1).
-STATEMENT RETURN setseed(1e30)
---- error
Runtime exception: Invalid seed 1e+30: setseed expects a value in the range [0, 1).

-CASE SetSeedNull
-LOG NullSeedIsSkippedAndDoesNotReseed
-STATEMENT RETURN setseed(0.2)
---- ok
-STATEMENT RETURN setseed(NULL)
---- 1

-STATEMENT RETURN setseed(CAST(NULL AS DOUBLE))
---- 1

-STATEMENT RETURN random()
---- 1
0.910543
-STATEMENT UNWIND [CAST(NULL AS DOUBLE), CAST(NULL AS DOUBLE)] AS s RETURN setseed(s)
---- 2
