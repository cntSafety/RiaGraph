-DATASET CSV EMPTY

--

# DECIMAL to an integer type has to reject a value that is outside the target's range, on both
# sides. The integral part used to be computed in the wider of the DECIMAL's physical type and the
# target, which is the unsigned target when both have the same size, so a negative DECIMAL wrapped
# and the minimum check could never fire: cast(cast(-1 as DECIMAL(5,0)) as UINT64) was
# 18446744073709551615. The DECIMAL precision picks the physical type: 1-4 INT16, 5-9 INT32,
# 10-18 INT64, 19-38 INT128.

-CASE CastDecimalToUnsignedNegative
-LOG UINT8
-STATEMENT RETURN cast(cast(-1 as DECIMAL(3,0)) as UINT8)
---- error
Overflow exception: Cast Failed: -1 is not in UINT8 range
-STATEMENT RETURN cast(cast(-1 as DECIMAL(5,0)) as UINT8)
---- error
Overflow exception: Cast Failed: -1 is not in UINT8 range
-LOG UINT16
-STATEMENT RETURN cast(cast(-1 as DECIMAL(3,0)) as UINT16)
---- error
Overflow exception: Cast Failed: -1 is not in UINT16 range
-STATEMENT RETURN cast(cast(-1 as DECIMAL(5,0)) as UINT16)
---- error
Overflow exception: Cast Failed: -1 is not in UINT16 range
-LOG UINT32
-STATEMENT RETURN cast(cast(-1 as DECIMAL(3,0)) as UINT32)
---- error
Overflow exception: Cast Failed: -1 is not in UINT32 range
-STATEMENT RETURN cast(cast(-1 as DECIMAL(5,0)) as UINT32)
---- error
Overflow exception: Cast Failed: -1 is not in UINT32 range
-STATEMENT RETURN cast(cast(-1 as DECIMAL(12,0)) as UINT32)
---- error
Overflow exception: Cast Failed: -1 is not in UINT32 range
-LOG UINT64
-STATEMENT RETURN cast(cast(-1 as DECIMAL(5,0)) as UINT64)
---- error
Overflow exception: Cast Failed: -1 is not in UINT64 range
-STATEMENT RETURN cast(cast(-1 as DECIMAL(3,0)) as UINT64)
---- error
Overflow exception: Cast Failed: -1 is not in UINT64 range
-STATEMENT RETURN cast(cast(-1 as DECIMAL(12,0)) as UINT64)
---- error
Overflow exception: Cast Failed: -1 is not in UINT64 range
-STATEMENT RETURN cast(cast(-1 as DECIMAL(25,0)) as UINT64)
---- error
Overflow exception: Cast Failed: -1 is not in UINT64 range
-LOG UINT128
-STATEMENT RETURN cast(cast(-1 as DECIMAL(5,0)) as UINT128)
---- error
Overflow exception: Cast Failed: -1 is not in UINT128 range
-STATEMENT RETURN cast(cast(-1 as DECIMAL(25,0)) as UINT128)
---- error
Overflow exception: Cast Failed: -1 is not in UINT128 range
-STATEMENT RETURN cast(cast(-99999999999999999999999999999999999999 as DECIMAL(38,0)) as UINT128)
---- error
Overflow exception: Cast Failed: -99999999999999999999999999999999999999 is not in UINT128 range
-LOG ScaledNegativeThatRoundsAwayFromZero
-STATEMENT RETURN cast(cast(-0.5 as DECIMAL(5,1)) as UINT64)
---- error
Overflow exception: Cast Failed: -0.5 is not in UINT64 range
-STATEMENT RETURN cast(cast(-1.5 as DECIMAL(12,2)) as UINT32)
---- error
Overflow exception: Cast Failed: -1.50 is not in UINT32 range

-CASE CastDecimalToUnsignedAboveMaximum
-STATEMENT RETURN cast(cast(256 as DECIMAL(3,0)) as UINT8)
---- error
Overflow exception: Cast Failed: 256 is not in UINT8 range
-STATEMENT RETURN cast(cast(65536 as DECIMAL(5,0)) as UINT16)
---- error
Overflow exception: Cast Failed: 65536 is not in UINT16 range
-STATEMENT RETURN cast(cast(4294967296 as DECIMAL(10,0)) as UINT32)
---- error
Overflow exception: Cast Failed: 4294967296 is not in UINT32 range
-STATEMENT RETURN cast(cast(18446744073709551616 as DECIMAL(20,0)) as UINT64)
---- error
Overflow exception: Cast Failed: 18446744073709551616 is not in UINT64 range
-STATEMENT RETURN cast(cast(99999 as DECIMAL(5,0)) as UINT8)
---- error
Overflow exception: Cast Failed: 99999 is not in UINT8 range

-CASE CastDecimalToSignedOutOfRange
-STATEMENT RETURN cast(cast(128 as DECIMAL(3,0)) as INT8)
---- error
Overflow exception: Cast Failed: 128 is not in INT8 range
-STATEMENT RETURN cast(cast(-129 as DECIMAL(3,0)) as INT8)
---- error
Overflow exception: Cast Failed: -129 is not in INT8 range
-STATEMENT RETURN cast(cast(32768 as DECIMAL(5,0)) as INT16)
---- error
Overflow exception: Cast Failed: 32768 is not in INT16 range
-STATEMENT RETURN cast(cast(-32769 as DECIMAL(5,0)) as INT16)
---- error
Overflow exception: Cast Failed: -32769 is not in INT16 range
-STATEMENT RETURN cast(cast(2147483648 as DECIMAL(10,0)) as INT32)
---- error
Overflow exception: Cast Failed: 2147483648 is not in INT32 range
-STATEMENT RETURN cast(cast(-2147483649 as DECIMAL(10,0)) as INT32)
---- error
Overflow exception: Cast Failed: -2147483649 is not in INT32 range
-STATEMENT RETURN cast(cast(9223372036854775808 as DECIMAL(19,0)) as INT64)
---- error
Overflow exception: Cast Failed: 9223372036854775808 is not in INT64 range
-STATEMENT RETURN cast(cast(-9223372036854775809 as DECIMAL(19,0)) as INT64)
---- error
Overflow exception: Cast Failed: -9223372036854775809 is not in INT64 range

-CASE CastDecimalToIntegerBoundariesKeepWorking
-LOG UnsignedMinimumAndMaximum
-STATEMENT RETURN cast(cast(0 as DECIMAL(5,0)) as UINT8), cast(cast(255 as DECIMAL(3,0)) as UINT8), cast(cast(0 as DECIMAL(3,0)) as UINT16), cast(cast(65535 as DECIMAL(5,0)) as UINT16)
---- 1
0|255|0|65535
-STATEMENT RETURN cast(cast(0 as DECIMAL(5,0)) as UINT32), cast(cast(4294967295 as DECIMAL(10,0)) as UINT32), cast(cast(0 as DECIMAL(12,0)) as UINT32), cast(cast(0 as DECIMAL(3,0)) as UINT64)
---- 1
0|4294967295|0|0
-STATEMENT RETURN cast(cast(0 as DECIMAL(5,0)) as UINT64), cast(cast(18446744073709551615 as DECIMAL(20,0)) as UINT64), cast(cast(0 as DECIMAL(25,0)) as UINT64), cast(cast(12345 as DECIMAL(9,0)) as UINT64)
---- 1
0|18446744073709551615|0|12345
-STATEMENT RETURN cast(cast(0 as DECIMAL(5,0)) as UINT128), cast(cast(99999999999999999999999999999999999999 as DECIMAL(38,0)) as UINT128), cast(cast(7 as DECIMAL(3,0)) as UINT128)
---- 1
0|99999999999999999999999999999999999999|7
-LOG SignedMinimumAndMaximum
-STATEMENT RETURN cast(cast(127 as DECIMAL(3,0)) as INT8), cast(cast(-128 as DECIMAL(3,0)) as INT8), cast(cast(32767 as DECIMAL(5,0)) as INT16), cast(cast(-32768 as DECIMAL(5,0)) as INT16)
---- 1
127|-128|32767|-32768
-STATEMENT RETURN cast(cast(2147483647 as DECIMAL(10,0)) as INT32), cast(cast(-2147483648 as DECIMAL(10,0)) as INT32), cast(cast(9223372036854775807 as DECIMAL(19,0)) as INT64), cast(cast(-9223372036854775808 as DECIMAL(19,0)) as INT64)
---- 1
2147483647|-2147483648|9223372036854775807|-9223372036854775808
-STATEMENT RETURN cast(cast(-99999999999999999999999999999999999999 as DECIMAL(38,0)) as INT128), cast(cast(-5 as DECIMAL(3,0)) as INT64), cast(cast(-5 as DECIMAL(25,0)) as INT32)
---- 1
-99999999999999999999999999999999999999|-5|-5
-LOG RoundingToZeroIsNotNegative
# -0.4 rounds half away from zero to 0, which is in range for an unsigned target.
-STATEMENT RETURN cast(cast(-0.4 as DECIMAL(5,1)) as UINT64), cast(cast(-0.4 as DECIMAL(3,1)) as UINT8), cast(cast(-0.04 as DECIMAL(12,2)) as UINT32)
---- 1
0|0|0
-STATEMENT RETURN cast(cast(2.5 as DECIMAL(5,1)) as UINT64), cast(cast(255.4 as DECIMAL(5,1)) as UINT8), cast(cast(-2.5 as DECIMAL(5,1)) as INT64)
---- 1
3|255|-3
