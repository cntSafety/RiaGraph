-CASE ConstantWithCreateInTransaction
-STATEMENT CREATE NODE TABLE T(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT WITH 1 AS x CREATE (:T {id: x});
---- ok
-STATEMENT MATCH (t:T) RETURN t.id;
---- 1
1
-STATEMENT COMMIT;
---- ok
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT WITH 2 AS x CREATE (:T {id: x});
---- ok
-STATEMENT ROLLBACK;
---- ok
-STATEMENT MATCH (t:T) RETURN t.id;
---- 1
