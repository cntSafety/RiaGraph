-CASE ConstantWithAfterMatchSkipLimitDistinct
-STATEMENT CREATE NODE TABLE T(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE NODE TABLE U(id SERIAL, v INT64, PRIMARY KEY(id));
---- ok
-STATEMENT UNWIND [1, 2, 3] AS i CREATE (:T {id: i});
---- ok
-STATEMENT MATCH (t:T) WITH 1 AS one CREATE (:U {v: 0});
---- ok
-STATEMENT MATCH (t:T) WITH 1 AS one LIMIT 1 CREATE (:U {v: 1});
---- ok
-STATEMENT MATCH (t:T) WITH 1 AS one SKIP 2 CREATE (:U {v: 2});
---- ok
-STATEMENT MATCH (t:T) WITH 1 AS one SKIP 5 CREATE (:U {v: 3});
---- ok
-STATEMENT MATCH (t:T) WITH DISTINCT 1 AS one CREATE (:U {v: 4});
---- ok
-STATEMENT MATCH (t:T) WITH 1 AS one LIMIT 0 CREATE (:U {v: 5});
---- ok
-STATEMENT MATCH (u:U) RETURN u.v, count(*);
---- 4
0|3
1|1
2|1
4|1
-STATEMENT MATCH (t:T) WITH 1 AS one LIMIT 1 RETURN one;
---- 1
1
-STATEMENT MATCH (t:T) WITH DISTINCT 1 AS one RETURN one;
---- 1
1
-STATEMENT MATCH (t:T) WITH 1 AS one SKIP 2 RETURN count(*);
---- 1
1
-STATEMENT MATCH (t:T) WITH DISTINCT 1 AS one, 2 AS two RETURN one, two;
---- 1
1|2
-STATEMENT MATCH (u:U) SET u.v = u.v + 10 WITH 1 AS one LIMIT 1 RETURN one;
---- 1
1
-STATEMENT MATCH (u:U) WHERE u.v >= 10 RETURN count(*);
---- 1
6
-STATEMENT MATCH (t:T) WITH 1 AS one RETURN count(*);
---- 1
3

-CASE ConstantWithMergeSetDelete
-STATEMENT CREATE NODE TABLE T(id INT64, v INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE R(FROM T TO T);
---- ok
-STATEMENT WITH 10 AS x MERGE (:T {id: x});
---- ok
-STATEMENT WITH 10 AS x MERGE (t:T {id: x}) RETURN t.id;
---- 1
10
-STATEMENT WITH 11 AS x MERGE (t:T {id: x}) ON CREATE SET t.v = 1 ON MATCH SET t.v = 2 RETURN t.v;
---- 1
1
-STATEMENT WITH 11 AS x MERGE (t:T {id: x}) ON CREATE SET t.v = 1 ON MATCH SET t.v = 2 RETURN t.v;
---- 1
2
-STATEMENT MATCH (t:T) RETURN t.id, t.v;
---- 2
10|
11|2
-STATEMENT WITH 10 AS x MATCH (t:T {id: x}) SET t.v = 100;
---- ok
-STATEMENT MATCH (t:T {id: 10}) RETURN t.v;
---- 1
100
-STATEMENT WITH 20 AS a, 21 AS b CREATE (:T {id: a})-[:R]->(:T {id: b});
---- ok
-STATEMENT WITH 10 AS a, 11 AS b MATCH (s:T {id: a}), (d:T {id: b}) CREATE (s)-[:R]->(d);
---- ok
-STATEMENT WITH 22 AS x CREATE (a:T {id: x}) WITH a, 23 AS y CREATE (a)-[:R]->(:T {id: y});
---- ok
-STATEMENT WITH 24 AS x MERGE (:T {id: x})-[:R]->(:T {id: x + 1});
---- ok
-STATEMENT MATCH (a:T)-[:R]->(b:T) RETURN a.id, b.id;
