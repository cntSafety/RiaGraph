20|21
22|23
24|25
-STATEMENT WITH 25 AS x MATCH (t:T {id: x}) DETACH DELETE t;
---- ok
-STATEMENT WITH 11 AS x MATCH (:T)-[r:R]->(t:T {id: x}) DELETE r;
---- ok
-STATEMENT WITH 11 AS x MATCH (t:T {id: x}) DELETE t;
---- ok
-STATEMENT MATCH (a:T)-[:R]->(b:T) RETURN a.id, b.id;
