-DATASET CSV empty
-SKIP_IN_MEM

--

# NaN in comparisons, filters, min/max and top-k. < and <= were the negations of >= and >,
# so they were true for a NaN operand: `x < 0.0` matched every NaN row, and min/max picked
# their extreme with them, so the answer depended on where a NaN fell in the input. Now the
# comparison operators are false for any NaN operand (as =, > and >= already were), while
# min/max and ORDER BY ... LIMIT use ORDER BY's order, in which NaN is the largest value.
# T has 1000 rows: d is NaN for k % 4 = 0 (k = 0 first) and k - 500.5 otherwise, so there are
# 250 NaNs, 375 negative and 375 positive values, and no zero. f is d as FLOAT.

-CASE NaNComparisonOperators
-STATEMENT RETURN 1.0 < CAST('nan' AS DOUBLE), CAST('nan' AS DOUBLE) < 1.0, 1.0 <= CAST('nan' AS DOUBLE), CAST('nan' AS DOUBLE) <= 1.0, CAST('nan' AS DOUBLE) > 1.0, CAST('nan' AS DOUBLE) >= 1.0, CAST('nan' AS DOUBLE) = CAST('nan' AS DOUBLE), CAST('nan' AS DOUBLE) <> CAST('nan' AS DOUBLE);
---- 1
False|False|False|False|False|False|False|True
-STATEMENT RETURN 1.0 < 2.0, 2.0 <= 2.0, 2 < 1, 'a' < 'b', [1, 2] < [1, 3], [1, NULL] < [1, 2], {a: 1} <= {a: 1};
---- 1
True|True|False|True|True|False|True

-CASE NaNFiltersMinMaxTopK
-STATEMENT CREATE NODE TABLE T(k INT64, d DOUBLE, f FLOAT, PRIMARY KEY(k));
---- ok
-STATEMENT COPY T FROM (UNWIND range(0, 999) AS k RETURN k, CASE WHEN k % 4 = 0 THEN CAST('nan' AS DOUBLE) ELSE k - 500.5 END AS d, CASE WHEN k % 4 = 0 THEN CAST('nan' AS FLOAT) ELSE CAST(k - 500.5 AS FLOAT) END AS f);
---- ok
# Filters pushed into the scan (column predicates) and evaluated as expressions.
-STATEMENT MATCH (t:T) WHERE t.d < 0.0 RETURN count(*);
---- 1
375
-STATEMENT MATCH (t:T) WHERE t.d <= 0.0 RETURN count(*);
---- 1
375
-STATEMENT MATCH (t:T) WHERE t.d > 0.0 RETURN count(*);
---- 1
375
-STATEMENT MATCH (t:T) WHERE t.f < 0.0 RETURN count(*);
---- 1
375
-STATEMENT MATCH (t:T) WHERE 0.0 > t.d RETURN count(*);
---- 1
375
-STATEMENT MATCH (t:T) WITH t.d AS d WHERE d < 0.0 RETURN count(*);
---- 1
375
-STATEMENT MATCH (t:T) WITH t.f AS f WHERE f <= 0.0 RETURN count(*);
---- 1
375
-STATEMENT MATCH (t:T) WITH t.d AS d, t.d - 1.0 AS e WHERE e < d RETURN count(*);
---- 1
750
-STATEMENT MATCH (t:T) RETURN min(t.d), max(t.d), min(t.f), max(t.f);
---- 1
-499.500000|nan|-499.500000|nan
-STATEMENT MATCH (t:T) RETURN min(DISTINCT t.d), max(DISTINCT t.d);
---- 1
-499.500000|nan
-STATEMENT MATCH (t:T) RETURN t.k % 2 AS g, min(t.d), max(t.d) ORDER BY g;
---- 2
0|-498.500000|nan
1|-499.500000|498.500000
-STATEMENT MATCH (t:T) WHERE t.k % 4 = 0 RETURN min(t.d), max(t.d);
---- 1
nan|nan
-STATEMENT MATCH (t:T) RETURN t.d ORDER BY t.d LIMIT 3;
-CHECK_ORDER
---- 3
-499.500000
-498.500000
-497.500000
-STATEMENT MATCH (t:T) RETURN t.d, t.k ORDER BY t.d DESC, t.k LIMIT 3;
-CHECK_ORDER
---- 3
nan|0
nan|4
nan|8
# Windows across the boundary between the numbers and the NaNs.
-STATEMENT MATCH (t:T) RETURN t.d ORDER BY t.d DESC SKIP 249 LIMIT 3;
-CHECK_ORDER
---- 3
nan
498.500000
497.500000
-STATEMENT MATCH (t:T) RETURN t.d ORDER BY t.d SKIP 749 LIMIT 3;
-CHECK_ORDER
---- 3
498.500000
nan
nan
-STATEMENT CHECKPOINT;
---- ok
-STATEMENT MATCH (t:T) WHERE t.d < 0.0 RETURN count(*);
---- 1
375
-STATEMENT MATCH (t:T) WHERE t.f <= 0.0 RETURN count(*);
---- 1
375
-STATEMENT MATCH (t:T) RETURN min(t.d), max(t.d), min(t.f), max(t.f);
---- 1
-499.500000|nan|-499.500000|nan
-STATEMENT MATCH (t:T) RETURN t.d, t.k ORDER BY t.d DESC, t.k LIMIT 3;
-CHECK_ORDER
---- 3
nan|0
nan|4
nan|8

-CASE NaNMinMaxIndependentOfInputOrder
-STATEMENT UNWIND [3.0, CAST('nan' AS DOUBLE), -1.0] AS x RETURN min(x), max(x);
---- 1
-1.000000|nan
-STATEMENT UNWIND [CAST('nan' AS DOUBLE), 3.0, -1.0] AS x RETURN min(x), max(x);
---- 1
-1.000000|nan
-STATEMENT UNWIND [-1.0, 3.0, CAST('nan' AS DOUBLE)] AS x RETURN min(x), max(x);
---- 1
-1.000000|nan
-STATEMENT UNWIND [CAST('-inf' AS DOUBLE), CAST('nan' AS DOUBLE), -1e308] AS x RETURN min(x), max(x);
---- 1
-inf|nan
-STATEMENT UNWIND [CAST('nan' AS DOUBLE), CAST('nan' AS DOUBLE)] AS x RETURN min(x), max(x);
---- 1
nan|nan
