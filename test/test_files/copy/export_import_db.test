# A sequence nothing was taken from must stay untaken across export/import: the
# first id after import is still its start value, not one increment later.
-CASE ExportImportUnusedSequence
-SKIP_WASM
-STATEMENT CREATE NODE TABLE unusedserial(ID serial, prop STRING, PRIMARY KEY(ID));
---- ok
-STATEMENT CREATE NODE TABLE usedserial(ID serial, prop STRING, PRIMARY KEY(ID));
---- ok
-STATEMENT CREATE (o:usedserial {prop: "Alice"})
---- ok
-STATEMENT CREATE SEQUENCE unusedstart START 5;
---- ok
-STATEMENT CREATE SEQUENCE unusedneg START -3 INCREMENT -2 MINVALUE -100 MAXVALUE -3;
---- ok
-STATEMENT CREATE SEQUENCE usedneg START -3 INCREMENT -2 MINVALUE -100 MAXVALUE -3;
---- ok
-STATEMENT RETURN nextval('usedneg');
---- 1
-3
-STATEMENT CREATE SEQUENCE rolledback START 7;
---- ok
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT RETURN nextval('rolledback');
---- 1
7
-STATEMENT ROLLBACK;
---- ok
-STATEMENT Export Database "${RIAG_EXPORT_DB_DIRECTORY}_unused_seq/demo-db" (format="parquet")
---- ok
-IMPORT_DATABASE "${RIAG_EXPORT_DB_DIRECTORY}_unused_seq/demo-db"
-STATEMENT IMPORT DATABASE "${RIAG_EXPORT_DB_DIRECTORY}_unused_seq/demo-db"
---- ok
-STATEMENT RETURN currval('unusedserial_ID_serial');
---- error
Catalog exception: currval: sequence "unusedserial_ID_serial" is not yet defined. To define the sequence, call nextval first.
-STATEMENT RETURN currval('rolledback');
---- error
Catalog exception: currval: sequence "rolledback" is not yet defined. To define the sequence, call nextval first.
-STATEMENT CREATE (o:unusedserial {prop: "Bob"})
---- ok
-STATEMENT CREATE (o:usedserial {prop: "Carol"})
---- ok
-STATEMENT MATCH (o:unusedserial) RETURN o.*;
---- 1
0|Bob
-STATEMENT MATCH (o:usedserial) RETURN o.*;
---- 2
0|Alice
1|Carol
-STATEMENT RETURN nextval('unusedstart'), nextval('unusedneg'), nextval('usedneg'), nextval('rolledback');
---- 1
5|-3|-5|7

