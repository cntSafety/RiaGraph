-CASE ExportImportDBWithNegativeAndRelDefaults
-STATEMENT CREATE NODE TABLE neg_defaults(id INT64, a INT64 DEFAULT -5, b DOUBLE DEFAULT -2.5, s STRING DEFAULT 'x', PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE RDEF(FROM neg_defaults TO neg_defaults, w INT64 DEFAULT 6, r DOUBLE DEFAULT -1.25);
---- ok
-STATEMENT ALTER TABLE neg_defaults ADD c INT64 DEFAULT 7;
---- ok
-STATEMENT EXPORT DATABASE '${RIAG_EXPORT_DB_DIRECTORY}_defaults/test_neg_rel';
---- ok
-IMPORT_DATABASE "${RIAG_EXPORT_DB_DIRECTORY}_defaults/test_neg_rel"
-STATEMENT IMPORT DATABASE "${RIAG_EXPORT_DB_DIRECTORY}_defaults/test_neg_rel";
---- ok
-STATEMENT CREATE (:neg_defaults {id: 1});
---- ok
-STATEMENT MATCH (t:neg_defaults {id: 1}) CREATE (t)-[:RDEF]->(t);
---- ok
-STATEMENT MATCH (t:neg_defaults)-[r:RDEF]->() RETURN t.a, t.b, t.s, t.c, r.w, r.r;
---- 1
-5|-2.500000|x|7|6|-1.250000
