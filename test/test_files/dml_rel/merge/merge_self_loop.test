-DATASET CSV empty

--

# MERGE of a rel whose two ends are the same node, (a)-[r]->(a). The existence check is planned
# over (a)-[r]->(a') WHERE a = a', but the rel MERGE creates, sets and returns must still end at
# a. It used to end at a', which is NULL when nothing matched, so MERGE returned its row and
# created nothing.

-CASE MergeSelfLoopOnBoundNode
-STATEMENT CREATE NODE TABLE T(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE K(FROM T TO T, v INT64);
---- ok
-STATEMENT CREATE (:T {id: 1}), (:T {id: 2}), (:T {id: 3}), (:T {id: 4});
---- ok
-STATEMENT MATCH (a:T {id: 1}) MERGE (a)-[r:K]->(a) RETURN a.id, r.v;
---- 1
1|
-STATEMENT MATCH (a:T)-[r:K]->(b:T) RETURN a.id, b.id;
---- 1
1|1
# Running it again matches the loop it created.
-STATEMENT MATCH (a:T {id: 1}) MERGE (a)-[r:K]->(a) RETURN a.id;
---- 1
1
-STATEMENT MATCH (a:T)-[r:K]->(a) RETURN count(r);
---- 1
1
# The rel MERGE returns ends at a on both the create and the match path.
-STATEMENT MATCH (a:T {id: 2}) MERGE (a)-[r:K]->(a) RETURN id(start_node(r)) = id(a), id(end_node(r)) = id(a), end_node(r).id;
---- 1
True|True|2
-STATEMENT MATCH (a:T {id: 2}) MERGE (a)-[r:K]->(a) RETURN id(start_node(r)) = id(a), id(end_node(r)) = id(a), end_node(r).id;
---- 1
True|True|2
# A rel from the node to another node is not a self-loop and must not match one.
-STATEMENT MATCH (a:T {id: 3}), (b:T {id: 4}) CREATE (a)-[:K {v: 7}]->(b);
---- ok
-STATEMENT MATCH (a:T {id: 3}) MERGE (a)-[r:K]->(a) RETURN a.id, r.v;
---- 1
3|
-STATEMENT MATCH (a:T {id: 3})-[r:K]->(b:T) RETURN b.id, r.v;
---- 2
3|
4|7
-STATEMENT MATCH (a:T)-[r:K]->(a) RETURN a.id;
---- 3
1
2
3

-CASE MergeSelfLoopOnCreateOnMatchSet
-STATEMENT CREATE NODE TABLE T(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE K(FROM T TO T, v INT64);
---- ok
-STATEMENT CREATE (:T {id: 1});
---- ok
-STATEMENT MATCH (a:T {id: 1}) MERGE (a)-[r:K]->(a) ON CREATE SET r.v = 1 ON MATCH SET r.v = r.v + 10 RETURN r.v;
---- 1
1
-STATEMENT MATCH (a:T {id: 1}) MERGE (a)-[r:K]->(a) ON CREATE SET r.v = 1 ON MATCH SET r.v = r.v + 10 RETURN r.v;
---- 1
11
-STATEMENT MATCH (a:T)-[r:K]->(b:T) RETURN a.id, b.id, r.v;
---- 1
1|1|11
# ON CREATE SET only, then ON MATCH SET only.
-STATEMENT CREATE (:T {id: 2});
---- ok
-STATEMENT MATCH (a:T {id: 2}) MERGE (a)-[r:K]->(a) ON CREATE SET r.v = 5 RETURN r.v;
---- 1
5
-STATEMENT MATCH (a:T {id: 2}) MERGE (a)-[r:K]->(a) ON MATCH SET r.v = r.v * 2 RETURN r.v;
---- 1
10
-STATEMENT MATCH (a:T)-[r:K]->(a) RETURN a.id, r.v;
---- 2
1|11
2|10

-CASE MergeSelfLoopDuplicateRows
-STATEMENT CREATE NODE TABLE T(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE K(FROM T TO T, v INT64);
---- ok
-STATEMENT CREATE (:T {id: 1}), (:T {id: 2}), (:T {id: 3});
---- ok
# The first row creates the loop, the later rows match it.
-STATEMENT UNWIND [1, 2, 3] AS k MATCH (a:T {id: 1}) MERGE (a)-[r:K]->(a) ON CREATE SET r.v = k ON MATCH SET r.v = r.v + 10 RETURN k, r.v;
---- 3
1|1
2|11
3|21
-STATEMENT MATCH (a:T)-[r:K]->(a) RETURN a.id, r.v;
---- 1
1|21
# Repeated and distinct nodes in one input: one loop per node.
-STATEMENT UNWIND [2, 3, 2, 3, 2] AS i MATCH (a:T {id: i}) MERGE (a)-[:K]->(a);
---- ok
-STATEMENT MATCH (a:T)-[r:K]->(b:T) RETURN a.id, b.id;
---- 3
1|1
2|2
3|3

-CASE MergeSelfLoopCreatesNode
-STATEMENT CREATE NODE TABLE T(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE K(FROM T TO T, v INT64);
---- ok
# The node is not bound before the MERGE: MERGE creates it and the loop on it.
-STATEMENT MERGE (a:T {id: 1})-[r:K {v: 3}]->(a) RETURN a.id, r.v;
---- 1
1|3
-STATEMENT MERGE (a:T {id: 1})-[r:K {v: 3}]->(a) RETURN a.id, r.v;
---- 1
1|3
-STATEMENT MATCH (a:T)-[r:K]->(b:T) RETURN a.id, b.id, r.v;
---- 1
1|1|3
-STATEMENT MATCH (a:T) RETURN count(*);
---- 1
1
# A loop followed by a rel to a new node, in one pattern.
-STATEMENT MATCH (a:T {id: 1}) MERGE (a)-[:K {v: 4}]->(a)-[:K {v: 5}]->(b:T {id: 2});
---- ok
-STATEMENT MATCH (a:T)-[r:K]->(b:T) RETURN a.id, b.id, r.v;
---- 3
1|1|3
1|1|4
1|2|5

-CASE MergeSelfLoopMultiLabelRelTable
-STATEMENT CREATE NODE TABLE T(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE NODE TABLE U(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE M(FROM T TO T, FROM T TO U, FROM U TO U, v INT64);
---- ok
-STATEMENT CREATE (:T {id: 1}), (:U {id: 10});
---- ok
-STATEMENT MATCH (a:T {id: 1}) MERGE (a)-[r:M]->(a) ON CREATE SET r.v = 1 ON MATCH SET r.v = r.v + 10 RETURN r.v;
---- 1
1
-STATEMENT MATCH (u:U {id: 10}) MERGE (u)-[r:M]->(u) ON CREATE SET r.v = 2 ON MATCH SET r.v = r.v + 10 RETURN r.v;
---- 1
2
-STATEMENT MATCH (a:T {id: 1}) MERGE (a)-[r:M]->(a) ON CREATE SET r.v = 1 ON MATCH SET r.v = r.v + 10 RETURN r.v;
---- 1
11
-STATEMENT MATCH (a:T {id: 1}), (u:U {id: 10}) MERGE (a)-[r:M]->(u) ON CREATE SET r.v = 3 RETURN r.v;
---- 1
3
-STATEMENT MATCH (x)-[r:M]->(y) RETURN x.id, y.id, r.v;
---- 3
1|1|11
1|10|3
10|10|2
-STATEMENT UNWIND [1, 2] AS k MATCH (u:U {id: 10}) MERGE (u)-[r:M]->(u) ON MATCH SET r.v = r.v + k RETURN r.v;
---- 2
3
5

-CASE MergeDistinctEndsUnchanged
-STATEMENT CREATE NODE TABLE T(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE K(FROM T TO T, v INT64);
---- ok
-STATEMENT CREATE (:T {id: 1}), (:T {id: 2});
---- ok
-STATEMENT MATCH (a:T {id: 1}), (b:T {id: 2}) MERGE (a)-[r:K]->(b) ON CREATE SET r.v = 1 ON MATCH SET r.v = r.v + 10 RETURN r.v;
---- 1
1
-STATEMENT MATCH (a:T {id: 1}), (b:T {id: 2}) MERGE (a)-[r:K]->(b) ON CREATE SET r.v = 1 ON MATCH SET r.v = r.v + 10 RETURN r.v;
---- 1
11
# Two variables bound to the same node: not a self-loop in the pattern, but it creates one.
-STATEMENT MATCH (a:T {id: 2}), (b:T {id: 2}) MERGE (a)-[r:K]->(b) ON CREATE SET r.v = 2 RETURN r.v;
---- 1
2
-STATEMENT MATCH (a:T {id: 2}), (b:T {id: 2}) MERGE (a)-[r:K]->(b) ON MATCH SET r.v = r.v + 10 RETURN r.v;
---- 1
12
-STATEMENT MATCH (a:T)-[r:K]->(b:T) RETURN a.id, b.id, r.v;
---- 2
1|2|11
2|2|12
